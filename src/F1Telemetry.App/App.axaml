<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:F1Telemetry.App.ViewModels"
             x:Class="F1Telemetry.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://F1Telemetry/Theme/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://F1Telemetry/Theme/Controls.axaml" />
  </Application.Styles>

  <Application.DataTemplates>
    <!-- A status chip renders the same everywhere: timing boards, lap list, overlays. -->
    <DataTemplate DataType="vm:Chip">
      <Border Classes="chip" Background="{Binding Background}" BorderBrush="{Binding Border}">
        <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}" />
      </Border>
    </DataTemplate>
  </Application.DataTemplates>
</Application>
