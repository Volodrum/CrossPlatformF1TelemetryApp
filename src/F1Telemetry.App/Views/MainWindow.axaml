<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:F1Telemetry.App.ViewModels"
        xmlns:views="using:F1Telemetry.App.Views"
        xmlns:controls="using:F1Telemetry.App.Controls"
        xmlns:protocol="using:F1Telemetry.Protocol"
        x:Class="F1Telemetry.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="F1 Telemetry"
        Width="1440" Height="900" MinWidth="1100" MinHeight="700">
  <DockPanel>
    <!-- Toolbar (design: Toolbar.dc.html) -->
    <Border DockPanel.Dock="Top" Height="72" Background="{StaticResource ChromeBrush}" Padding="20,0"
            BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,2">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="20" VerticalAlignment="Center">
        <Button Theme="{StaticResource PrimaryButton}" Content="{Binding RecordButtonText}" Command="{Binding ToggleRecordingCommand}" MinWidth="200" />

        <!-- Telemetry mode: must match the game's Settings → Telemetry → UDP Format -->
        <Border Grid.Column="1" Classes="segmented" VerticalAlignment="Center"
                ToolTip.Tip="Telemetry mode – must match the UDP Format selected in the game">
          <StackPanel Orientation="Horizontal">
            <Button Theme="{StaticResource ModeToggle}" Content="F1 25" Classes.selected="{Binding IsF125Mode}"
                    Command="{Binding SetModeCommand}" CommandParameter="{x:Static protocol:GameFormat.F1_25}" />
            <Button Theme="{StaticResource ModeToggle}" Content="F1 26" Classes.selected="{Binding IsF126Mode}"
                    Command="{Binding SetModeCommand}" CommandParameter="{x:Static protocol:GameFormat.F1_26}" />
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Classes="label" Text="SOURCE" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" MinWidth="220">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SourceOption">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
          <TextBlock Classes="h2" Text="{Binding Live.Session}" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="mono" Text="{Binding Live.IngestStatus}" FontSize="13" Foreground="{StaticResource TextLoBrush}" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Border Grid.Column="4" Height="32" CornerRadius="16" Padding="12,0" Background="{StaticResource FasterTintBrush}"
                IsVisible="{Binding Live.IsReceiving}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Ellipse Width="10" Height="10" Fill="{StaticResource FasterBrush}" />
            <TextBlock Text="LIVE" FontFamily="{StaticResource DisplayFont}" FontSize="13" FontWeight="Bold" LetterSpacing="1.3" Foreground="{StaticResource FasterBrush}" />
          </StackPanel>
        </Border>

        <ToggleSwitch Grid.Column="5" IsChecked="{Binding OverlaysEnabled}" OnContent="OVERLAYS" OffContent="OVERLAYS" VerticalAlignment="Center" />

        <Button Grid.Column="6" Theme="{StaticResource SecondaryButton}" Padding="0" Width="44" Command="{Binding ToggleSettingsCommand}"
                Classes.selected="{Binding IsSettingsOpen}" ToolTip.Tip="Settings" AutomationProperties.Name="Settings">
          <PathIcon Width="20" Height="20" Foreground="{StaticResource TextMidBrush}"
                    Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" />
        </Button>
      </Grid>
    </Border>

    <!-- Mode mismatch warning -->
    <Border DockPanel.Dock="Top" Background="{StaticResource WarningTintBrush}" Padding="20,10" IsVisible="{Binding Live.HasModeWarning}">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Border Classes="pill" Background="{StaticResource SlowerBrush}">
          <TextBlock Text="MODE" FontFamily="{StaticResource DisplayFont}" FontSize="13" FontWeight="Bold" LetterSpacing="1.3" Foreground="{StaticResource OnColorBrush}" />
        </Border>
        <TextBlock Text="{Binding Live.ModeWarning}" Foreground="{StaticResource SlowerBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource ChromeBrush}" Padding="20,6" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,2,0,0">
      <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextMidBrush}" FontSize="13" />
    </Border>

    <!-- Navigation rail: what the user is doing. Picking a section also leaves the settings page. -->
    <Border DockPanel.Dock="Left" Width="96" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,2,0">
      <StackPanel Margin="0,16" Spacing="6">
        <Button Theme="{StaticResource RailButton}" Classes.selected="{Binding IsLiveActive}"
                Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:MainSection.Live}"
                ToolTip.Tip="Live dashboard: what the car is doing now" AutomationProperties.Name="Live">
          <StackPanel Spacing="6">
            <PathIcon Width="24" Height="24" HorizontalAlignment="Center"
                      Data="M12,16A3,3 0 0,1 9,13C9,11.88 9.61,10.9 10.5,10.39L20.21,4.77L14.68,14.35C14.18,15.33 13.17,16 12,16M12,3C13.81,3 15.5,3.5 16.97,4.32L14.87,5.53C14,5.19 13,5 12,5A8,8 0 0,0 4,13C4,15.21 4.89,17.21 6.34,18.65H6.35C6.74,19.04 6.74,19.67 6.35,20.06C5.96,20.45 5.32,20.45 4.93,20.07V20.07C3.12,18.26 2,15.76 2,13A10,10 0 0,1 12,3M22,13C22,15.76 20.88,18.26 19.07,20.07V20.07C18.68,20.45 18.05,20.45 17.66,20.06C17.27,19.67 17.27,19.04 17.66,18.65V18.65C19.11,17.2 20,15.21 20,13C20,12 19.81,11 19.46,10.1L20.67,8C21.5,9.5 22,11.18 22,13Z" />
            <TextBlock Text="LIVE" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Theme="{StaticResource RailButton}" Classes.selected="{Binding IsSessionActive}"
                Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:MainSection.Session}"
                ToolTip.Tip="One recorded session: laps, strategy and energy" AutomationProperties.Name="Session">
          <StackPanel Spacing="6">
            <PathIcon Width="24" Height="24" HorizontalAlignment="Center"
                      Data="M16,11.78L20.24,4.45L21.97,5.45L16.74,14.5L10.23,10.75L5.46,19H22V21H2V3H4V17.54L9.5,8L16,11.78Z" />
            <TextBlock Text="SESSION" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Theme="{StaticResource RailButton}" Classes.selected="{Binding IsCompareActive}"
                Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:MainSection.Compare}"
                ToolTip.Tip="Race vs race: two recordings of the same track" AutomationProperties.Name="Compare">
          <StackPanel Spacing="6">
            <PathIcon Width="24" Height="24" HorizontalAlignment="Center" Data="M21,9L17,5V8H10V10H17V13M7,11L3,15L7,19V16H14V14H7V11Z" />
            <TextBlock Text="COMPARE" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Theme="{StaticResource RailButton}" Classes.selected="{Binding IsSetupsActive}"
                Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:MainSection.Setups}"
                ToolTip.Tip="Setup library: every setup you drove" AutomationProperties.Name="Setups">
          <StackPanel Spacing="6">
            <PathIcon Width="24" Height="24" HorizontalAlignment="Center"
                      Data="M22.7,19L13.6,9.9C14.5,7.6 14,4.9 12.1,3C10.1,1 7.1,0.6 4.7,1.7L9,6L6,9L1.6,4.7C0.4,7.1 0.9,10.1 2.9,12.1C4.8,14 7.5,14.5 9.8,13.6L18.9,22.7C19.3,23.1 19.9,23.1 20.3,22.7L22.6,20.4C23.1,20 23.1,19.3 22.7,19Z" />
            <TextBlock Text="SETUPS" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Theme="{StaticResource RailButton}" Classes.selected="{Binding IsOverlaysActive}"
                Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:MainSection.Overlays}"
                ToolTip.Tip="HUD overlays over the game: what shows, where and how big" AutomationProperties.Name="Overlays">
          <StackPanel Spacing="6">
            <PathIcon Width="24" Height="24" HorizontalAlignment="Center"
                      Data="M12,16L19.36,10.27L21,9L12,2L3,9L4.63,10.27M12,18.54L4.62,12.81L3,14.07L12,21.07L21,14.07L19.37,12.8L12,18.54Z" />
            <TextBlock Text="OVERLAYS" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>

    <!-- Recordings sidebar (design: Sidebar.dc.html): only in the session section, the one part of the app it drives -->
    <Border DockPanel.Dock="Left" Width="300" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,2,0"
            IsVisible="{Binding IsSessionActive}">
      <DockPanel Margin="16,20">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,12">
          <TextBlock Classes="label strong" Text="RECORDINGS" LetterSpacing="2" VerticalAlignment="Center" />
          <Button Grid.Column="1" Theme="{StaticResource SecondaryButton}" Padding="0" Width="44" Command="{Binding RefreshRecordingsCommand}"
                  ToolTip.Tip="Refresh recordings" AutomationProperties.Name="Refresh recordings">
            <PathIcon Width="18" Height="18" Foreground="{StaticResource TextMidBrush}"
                      Data="M17.65,6.35 A7.95,7.95 0 0 0 12,4 A8,8 0 1 0 19.73,14 L17.65,14 A6,6 0 1 1 12,6 A5.9,5.9 0 0 1 16.22,7.78 L13,11 L20,11 L20,4 Z" />
          </Button>
          <Button Grid.Column="2" Theme="{StaticResource SecondaryButton}" Padding="0" Width="44" Command="{Binding DeleteRecordingCommand}"
                  CommandParameter="{Binding SelectedRecording}" ToolTip.Tip="Delete selected recording" AutomationProperties.Name="Delete selected recording">
            <PathIcon Width="18" Height="18" Foreground="{StaticResource TextMidBrush}"
                      Data="M9,3 L15,3 L15,5 L20,5 L20,7 L4,7 L4,5 L9,5 Z M6,8 L18,8 L17,21 L7,21 Z" />
          </Button>
        </Grid>

        <!-- Delete confirmation: deleting also removes the recording's raw captures and can't be undone. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource WarningTintBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="2"
                CornerRadius="8" Padding="12" Margin="0,0,0,12" IsVisible="{Binding PendingDelete, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Spacing="10">
            <StackPanel Spacing="2">
              <TextBlock Classes="label strong" Text="DELETE THIS RECORDING?" Foreground="{StaticResource DangerBrush}" />
              <TextBlock Classes="h2" Text="{Binding PendingDelete.Title, FallbackValue=''}" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="mono" Text="{Binding PendingDelete.Subtitle, FallbackValue=''}" FontSize="13" Foreground="{StaticResource TextMidBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock Classes="body" FontSize="13" TextWrapping="Wrap" Text="Its laps, telemetry and raw capture files go too, and its runs leave the setup library. This can't be undone." />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <Button Theme="{StaticResource PrimaryButton}" Content="DELETE" Command="{Binding ConfirmDeleteCommand}" HorizontalAlignment="Stretch" />
              <Button Grid.Column="1" Theme="{StaticResource SecondaryButton}" Content="CANCEL" Command="{Binding CancelDeleteCommand}" HorizontalAlignment="Stretch" />
            </Grid>
          </StackPanel>
        </Border>

        <ListBox Classes="cards" ItemsSource="{Binding Recordings}" SelectedItem="{Binding SelectedRecording}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:RecordingItemViewModel">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock Classes="h2" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                  <Border Grid.Column="1" Classes="pill" Background="{StaticResource BrandBrush}" IsVisible="{Binding IsLive}" VerticalAlignment="Center">
                    <TextBlock Text="LIVE" FontFamily="{StaticResource DisplayFont}" FontSize="12" FontWeight="Bold" LetterSpacing="1.2" Foreground="White" />
                  </Border>
                </Grid>
                <TextBlock Classes="mono" Text="{Binding Subtitle}" FontSize="13" Foreground="{StaticResource TextMidBrush}" />
                <TextBlock Text="{Binding Description}" FontSize="13" Foreground="{StaticResource TextLoBrush}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Main area: the rail's section, or the settings page (opened from the toolbar) in its place -->
    <Panel>
      <DockPanel Margin="20,12,20,16" MaxWidth="1100" HorizontalAlignment="Left" IsVisible="{Binding IsSettingsOpen}">
        <controls:PageHeader DockPanel.Dock="Top" Eyebrow="APP · CONTROLS, CONNECTION AND DATA" Title="Settings" Margin="0,4,0,0"
                             Help="Overlays are set up on their own page: OVERLAYS in the rail.">
          <Button Theme="{StaticResource SecondaryButton}" Content="DONE" Command="{Binding CloseSettingsCommand}" MinWidth="120" ToolTip.Tip="Back (Esc)" />
        </controls:PageHeader>
        <views:SettingsView DataContext="{Binding Settings}" />
      </DockPanel>

      <!-- Each view sets its own DataContext, so its visibility sits on a wrapper bound to this window's view model. -->
      <Panel Margin="20,12,20,16" IsVisible="{Binding IsLiveActive}">
        <views:LiveView DataContext="{Binding Live}" />
      </Panel>

      <!-- Session: the recording picked in the sidebar, in three views. The laps view drills into one lap. -->
      <TabControl Classes="sections" SelectedIndex="{Binding SessionTabIndex}" Margin="20,12,20,16" IsVisible="{Binding IsSessionActive}">
        <TabItem Header="LAPS">
          <Panel>
            <Panel IsVisible="{Binding !IsLapOpen}">
              <views:LapsView DataContext="{Binding Session}" />
            </Panel>
            <Panel IsVisible="{Binding IsLapOpen}">
              <views:LapDetailView DataContext="{Binding LapDetail}" />
            </Panel>
          </Panel>
        </TabItem>
        <TabItem Header="STRATEGY">
          <views:StrategyView DataContext="{Binding Session}" />
        </TabItem>
        <TabItem Header="ENERGY">
          <views:EnergyView DataContext="{Binding Energy}" />
        </TabItem>
      </TabControl>

      <!-- Compare: race vs race, or lap vs lap across recordings of a track. -->
      <TabControl Classes="sections" SelectedIndex="{Binding CompareTabIndex}" Margin="20,12,20,16" IsVisible="{Binding IsCompareActive}">
        <TabItem Header="RACES">
          <views:CompareView DataContext="{Binding Compare}" />
        </TabItem>
        <TabItem Header="LAPS">
          <views:LapDetailView DataContext="{Binding LapCompare}" />
        </TabItem>
      </TabControl>

      <Panel Margin="20,12,20,16" IsVisible="{Binding IsSetupsActive}">
        <views:SetupsView DataContext="{Binding Setups}" />
      </Panel>
      <Panel Margin="20,12,20,16" IsVisible="{Binding IsOverlaysActive}">
        <views:OverlaysView DataContext="{Binding Settings}" />
      </Panel>
    </Panel>
  </DockPanel>
</Window>
