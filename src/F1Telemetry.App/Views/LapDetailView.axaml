<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:F1Telemetry.App.ViewModels"
             xmlns:controls="using:F1Telemetry.App.Controls"
             x:Class="F1Telemetry.App.Views.LapDetailView"
             x:DataType="vm:LapDetailViewModel">
  <!-- Design: LapDetail.dc.html -->
  <DockPanel Margin="0,16,0,0">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="16" Margin="0,0,0,12">
      <!-- In the session the lap detail is the laps tab drilled into one lap: back returns to the list. -->
      <Button Theme="{StaticResource SecondaryButton}" Padding="12,0" Command="{Binding BackCommand}" VerticalAlignment="Center" IsVisible="{Binding ShowBack}"
              ToolTip.Tip="Back to all laps (Esc)" AutomationProperties.Name="Back to all laps">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Width="16" Height="16" Data="M20,11 L7.83,11 L13.42,5.41 L12,4 L4,12 L12,20 L13.41,18.59 L7.83,13 L20,13 Z" />
          <TextBlock Text="ALL LAPS" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <StackPanel Grid.Column="1" Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="label" Text="{Binding Context}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <controls:HelpTip Width="18" Height="18"
                            Text="Lap A is the solid trace, lap B the dashed one: B can be any lap of any recording on the same track. Charts: scroll moves down the page, Ctrl + scroll zooms along the lap, drag pans; the value axis stays fixed. Trajectory: the wheel zooms, drag pans, double-click resets." />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="14">
          <TextBlock Classes="h1" Text="{Binding Title}" />
          <TextBlock Classes="data-m" FontSize="30" Text="{Binding LapTime}" VerticalAlignment="Bottom" />
          <TextBlock Classes="muted" Text="Loading…" IsVisible="{Binding IsLoading}" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
      <ContentControl Grid.Column="2" Content="{Binding DeltaChip}" VerticalAlignment="Center" />
      <controls:CompoundBadge Grid.Column="3" Compound="{Binding Compound}" Width="44" Height="44" VerticalAlignment="Center" />
    </Grid>

    <!-- Lap A vs lap B (any recording on the same track), with the shared compare bar. -->
    <controls:CompareBar DockPanel.Dock="Top" Margin="0,0,0,12" IsVisible="{Binding ShowPickers}" ALabel="LAP" BLabel="AGAINST">
      <controls:CompareBar.AContent>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ComboBox ItemsSource="{Binding Recordings}" SelectedItem="{Binding SelectedRecording}" MinWidth="230" VerticalAlignment="Center"
                    IsVisible="{Binding IsWorkspace}" />
          <ComboBox ItemsSource="{Binding LapOptions}" SelectedItem="{Binding SelectedLap}" MinWidth="200" VerticalAlignment="Center" />
        </StackPanel>
      </controls:CompareBar.AContent>
      <controls:CompareBar.BContent>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ComboBox ItemsSource="{Binding CompareRecordings}" SelectedItem="{Binding SelectedCompareRecording}" MinWidth="190" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding CompareLaps}" SelectedItem="{Binding SelectedCompareLap}" MinWidth="200" VerticalAlignment="Center" />
        </StackPanel>
      </controls:CompareBar.BContent>
      <controls:CompareBar.Extra>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Classes="label strong" Text="X AXIS" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{x:Static vm:LapDetailViewModel.XAxisOptions}" SelectedItem="{Binding SelectedXAxis}" MinWidth="140" VerticalAlignment="Center" />
        </StackPanel>
      </controls:CompareBar.Extra>
    </controls:CompareBar>

    <DockPanel IsVisible="{Binding HasData}">
      <!-- Sector split vs the comparison lap: one compact full-width strip. -->
      <Border DockPanel.Dock="Top" Classes="panel" Padding="16,10" Margin="0,0,0,12">
        <ItemsControl ItemsSource="{Binding Sectors}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="3" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SectorCard">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Classes="label strong" Text="{Binding Label}" VerticalAlignment="Center" />
                <TextBlock Classes="data-m" Text="{Binding Time}" VerticalAlignment="Center" />
                <ContentControl Content="{Binding Delta}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <Border DockPanel.Dock="Top" Classes="segmented" HorizontalAlignment="Left" Margin="0,0,0,12">
        <TabControl Classes="segments" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" Padding="0">
          <TabControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChartTabViewModel">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </TabControl.ItemTemplate>
          <TabControl.ContentTemplate>
            <DataTemplate x:DataType="vm:ChartTabViewModel">
              <Panel />
            </DataTemplate>
          </TabControl.ContentTemplate>
        </TabControl>
      </Border>

      <Panel>
        <!-- Chart tabs: full width. -->
        <DockPanel IsVisible="{Binding ShowCharts}">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding SelectedTab.Charts, FallbackValue={x:Null}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChartModel">
                  <Border Classes="panel" Padding="0" Margin="0,0,8,12" Height="250">
                    <controls:TelemetryPlot Model="{Binding}" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>

        <!-- Trajectory tab: the track map at full size. -->
        <DockPanel IsVisible="{Binding ShowTrajectory}">
          <ToggleSwitch DockPanel.Dock="Top" IsChecked="{Binding ColorByInputs}" OnContent="COLOUR BY INPUTS" OffContent="TRAJECTORY ONLY" Margin="0,0,0,12" />
          <Border Classes="panel" Padding="0" ClipToBounds="True">
            <Panel>
              <controls:TrackMapControl Outline="{Binding Outline}" ActiveLap="{Binding Samples}" ReferenceLap="{Binding ReferenceSamples}" ColorByInputs="{Binding ColorByInputs}" />
              <TextBlock Classes="h2" Text="{Binding TrackName}" FontSize="20" Margin="16,14" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
              <StackPanel Margin="16,14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Spacing="8" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="18" Height="6" CornerRadius="3" Background="{StaticResource FasterBrush}" VerticalAlignment="Center" /><TextBlock Classes="label" Text="FULL THROTTLE" Foreground="{StaticResource FasterBrush}" /></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="18" Height="6" CornerRadius="3" Background="{StaticResource SlowerBrush}" VerticalAlignment="Center" /><TextBlock Classes="label" Text="PARTIAL" Foreground="{StaticResource SlowerBrush}" /></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="18" Height="6" CornerRadius="3" Background="{StaticResource DangerBrush}" VerticalAlignment="Center" /><TextBlock Classes="label" Text="BRAKING" Foreground="{StaticResource DangerBrush}" /></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasReference}"><Border Width="18" Height="3" BorderBrush="{StaticResource TextLoBrush}" BorderThickness="0,2,0,0" VerticalAlignment="Center" /><TextBlock Classes="label" Text="{Binding ReferenceLegend}" /></StackPanel>
              </StackPanel>
            </Panel>
          </Border>
        </DockPanel>
      </Panel>
    </DockPanel>
  </DockPanel>
</UserControl>
