<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:F1Telemetry.App.ViewModels"
             xmlns:controls="using:F1Telemetry.App.Controls"
             xmlns:views="using:F1Telemetry.App.Views"
             x:Class="F1Telemetry.App.Views.StrategyView"
             x:DataType="vm:SessionViewModel">
  <!-- Design: Strategy.dc.html -->
  <DockPanel Margin="0,16,0,0">
    <controls:PageHeader DockPanel.Dock="Top" Eyebrow="RACE STRATEGY" Title="{Binding Header}" Margin="0,0,8,12"
                         Help="THIS SESSION: what happened. Stints come from the game's tyre history; pit, safety-car and out-laps are excluded from every average. Pick a stint to see its tyre life, degradation and fuel. RACE PLANS: what to do in the race, from every recording at this track. DATA GUIDE: what those plans rest on, and what to drive in practice, qualifying and the race to measure the rest." />

    <!-- Pages: the session as it went, the plans for the race, and how to feed the plans -->
    <Border DockPanel.Dock="Top" Classes="segmented" HorizontalAlignment="Left" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal">
        <Button Theme="{StaticResource ModeToggle}" Content="THIS SESSION" Classes.selected="{Binding IsSessionPage}"
                Command="{Binding SetStrategyPageCommand}" CommandParameter="{x:Static vm:StrategyPage.Session}"
                ToolTip.Tip="What happened: stints, tyre life, degradation, fuel, pit stops and positions" />
        <Button Theme="{StaticResource ModeToggle}" Content="RACE PLANS" Classes.selected="{Binding IsPlansPage}"
                Command="{Binding SetStrategyPageCommand}" CommandParameter="{x:Static vm:StrategyPage.Plans}"
                ToolTip.Tip="What to do in the race: the track's compounds and the ranked 1-, 2- and 3-stop plans" />
        <Button Theme="{StaticResource ModeToggle}" Content="DATA GUIDE" Classes.selected="{Binding IsGuidePage}"
                Command="{Binding SetStrategyPageCommand}" CommandParameter="{x:Static vm:StrategyPage.Guide}"
                ToolTip.Tip="What the plans rest on here, and what to drive to measure the rest" />
      </StackPanel>
    </Border>

    <Panel>
  <ScrollViewer IsVisible="{Binding IsSessionPage}">
    <StackPanel Spacing="16" Margin="0,0,8,0">

      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
        <ListBox Classes="cards horizontal" ItemsSource="{Binding Stints}" SelectedItem="{Binding SelectedStint}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:StintViewModel">
              <StackPanel Orientation="Horizontal" Spacing="12" MinWidth="220">
                <controls:CompoundBadge Compound="{Binding Compound}" Width="40" Height="40" />
                <StackPanel Spacing="2" VerticalAlignment="Center">
                  <TextBlock Classes="h2" Text="{Binding Header}" />
                  <TextBlock Classes="mono" Text="{Binding Laps}" FontSize="13" Foreground="{StaticResource TextMidBrush}" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <ContentControl Content="{Binding SelectedStint}">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="vm:StintViewModel">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
              <!-- Tyre life -->
              <Border Classes="panel" Padding="18">
                <StackPanel Spacing="14">
                  <TextBlock Classes="label strong" Text="TYRE LIFE" FontSize="14" />
                  <StackPanel Orientation="Horizontal" Spacing="10" Background="Transparent" ToolTip.Tip="{Binding LifespanNote}">
                    <TextBlock Classes="data-xl" Text="{Binding Lifespan}" />
                    <TextBlock Classes="unit" Text="LAPS · FRESH SET" FontSize="17" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding Wheels}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:WheelRate">
                        <Border Background="{Binding Background}" BorderBrush="{Binding Border}" BorderThickness="2" CornerRadius="8" Padding="10,8" Margin="0,0,8,8">
                          <StackPanel Spacing="2">
                            <TextBlock Classes="label" Text="{Binding Label}" Foreground="{Binding Foreground}" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <TextBlock Classes="data-m" FontSize="22" Text="{Binding Rate}" Foreground="{Binding Foreground}" />
                              <TextBlock Classes="unit" FontSize="14" Text="/LAP" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border BorderBrush="{StaticResource SlowerBrush}" BorderThickness="2" CornerRadius="8" Padding="12,10" IsVisible="{Binding HasLimiting}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="label" Text="{Binding LimitingName}" FontSize="14" Foreground="{StaticResource SlowerBrush}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="data-m" FontSize="22" Text="{Binding LimitingLaps}" Foreground="{StaticResource SlowerBrush}" />
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>

              <!-- Pace degradation -->
              <Border Grid.Column="1" Classes="panel" Padding="18">
                <StackPanel Spacing="14">
                  <TextBlock Classes="label strong" Text="TYRE DEGRADATION" FontSize="14" />
                  <StackPanel Orientation="Horizontal" Spacing="10" Background="Transparent" ToolTip.Tip="{Binding PaceTip}">
                    <TextBlock Classes="data-xl" Text="{Binding Pace}" Foreground="{Binding PaceBrush}" />
                    <TextBlock Classes="unit" Text="S / LAP" FontSize="17" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding Bars}" Height="130">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:LapBar">
                        <StackPanel Spacing="6" VerticalAlignment="Bottom">
                          <Border Width="30" Height="{Binding Height}" CornerRadius="3" Background="{Binding Fill}" />
                          <TextBlock Classes="mono" Text="{Binding Label}" FontSize="12" Foreground="{StaticResource TextMidBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <UniformGrid Columns="2">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="label" Text="BEST" />
                      <TextBlock Classes="data-m" FontSize="22" Text="{Binding Best}" Foreground="{StaticResource SessionBestBrush}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                      <TextBlock Classes="label" Text="AVERAGE" />
                      <TextBlock Classes="data-m" FontSize="22" Text="{Binding Average}" />
                    </StackPanel>
                  </UniformGrid>
                </StackPanel>
              </Border>

              <!-- Fuel -->
              <Border Grid.Column="2" Classes="panel" Padding="18">
                <StackPanel Spacing="14">
                  <TextBlock Classes="label strong" Text="FUEL" FontSize="14" />
                  <StackPanel Orientation="Horizontal" Spacing="10" Background="Transparent" ToolTip.Tip="{Binding FuelNote}">
                    <TextBlock Classes="data-xl" Text="{Binding Fuel}" />
                    <TextBlock Classes="unit" Text="KG / LAP" FontSize="17" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>

      <!-- Pit stops: in-lap + out-lap against what each would have been as a clean lap -->
      <Border Classes="panel" Padding="18" IsVisible="{Binding HasPitStops}">
        <StackPanel Spacing="12">
          <TextBlock Classes="label strong" Text="PIT STOPS · TIME LOST ON THE IN-LAP AND OUT-LAP" />
          <ItemsControl ItemsSource="{Binding PitStops}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PitStopRowViewModel">
                <Grid ColumnDefinitions="90,Auto,Auto,Auto,150,*" ColumnSpacing="12" Margin="0,4">
                  <TextBlock Classes="mono" Text="{Binding Laps}" FontSize="14" VerticalAlignment="Center" />
                  <controls:CompoundBadge Grid.Column="1" Compound="{Binding FromCompound}" Width="28" Height="28" />
                  <TextBlock Grid.Column="2" Classes="muted" Text="→" VerticalAlignment="Center" />
                  <controls:CompoundBadge Grid.Column="3" Compound="{Binding ToCompound}" Width="28" Height="28" />
                  <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Classes="data-m" FontSize="22" Text="{Binding Loss}" Foreground="{StaticResource SlowerBrush}" />
                    <TextBlock Classes="unit" Text="S LOST" FontSize="14" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                  </StackPanel>
                  <TextBlock Grid.Column="5" Classes="body" Text="{Binding Detail}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Position history (was its own tab) -->
      <Border Classes="panel" Padding="0" Height="260" IsVisible="{Binding PositionChart, Converter={x:Static ObjectConverters.IsNotNull}}">
        <controls:TelemetryPlot Model="{Binding PositionChart}" />
      </Border>

      <!-- Fuel load calculator (session-level: uses the selected stint's rate) -->
      <Border Classes="panel" HorizontalAlignment="Left" MinWidth="460" Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Classes="label strong" Text="FUEL LOAD CALCULATOR · SELECTED STINT RATE" />
          <StackPanel Orientation="Horizontal" Spacing="16">
            <TextBlock Classes="h2" Text="Target laps" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding TargetLaps}" Minimum="1" Maximum="100" Increment="1" FormatString="0" Width="140" />
            <TextBlock Classes="data-l" Text="{Binding FuelForTarget}" Foreground="#FFD12E" VerticalAlignment="Center" />
            <TextBlock Classes="unit" Text="KG TO ADD" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

  <ScrollViewer IsVisible="{Binding IsPlansPage}">
    <StackPanel Spacing="16" Margin="0,0,8,0">
      <!-- How much of what the plans use was measured here: one line, with the way to the guide -->
      <Border Classes="raised" Padding="14,10" IsVisible="{Binding Plans.HasGuide}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
          <TextBlock Classes="label strong" Text="{Binding Plans.GuideScore}" VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="{Binding Plans.GuideNext}" />
          <ProgressBar Grid.Column="1" Classes="bar" Minimum="0" Maximum="1" Value="{Binding Plans.GuideProgress}" Foreground="{StaticResource FasterBrush}"
                       MaxWidth="240" HorizontalAlignment="Left" VerticalAlignment="Center" />
          <Button Grid.Column="2" Theme="{StaticResource SecondaryButton}" Content="DATA GUIDE" Command="{Binding SetStrategyPageCommand}"
                  CommandParameter="{x:Static vm:StrategyPage.Guide}" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- Strategy optimiser: the track's compound library (the hub's sessions and every recording not saved to it) and the race plans it gives -->
      <views:RacePlansPanel DataContext="{Binding Plans}" />
    </StackPanel>
  </ScrollViewer>

  <!-- Data guide: what the plans rest on at this track, shown rather than written. Each item is a card with a little
       animation of the run that measures it; the next one is large and moving, the rest move under the pointer. The
       words (what is recorded, what to do, why) are in each card's tooltip. -->
  <ScrollViewer IsVisible="{Binding IsGuidePage}">
    <StackPanel Spacing="16" Margin="0,0,8,0" DataContext="{Binding Plans}" x:DataType="vm:RacePlansViewModel">

      <TextBlock Classes="body" Text="Select a recording to see what the plans know at its track." IsVisible="{Binding !HasGuide}" />

      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" IsVisible="{Binding HasGuide}">
        <TextBlock Classes="label strong" FontSize="14" Text="{Binding GuideScore}" VerticalAlignment="Center" />
        <ProgressBar Grid.Column="1" Classes="bar" Minimum="0" Maximum="1" Value="{Binding GuideProgress}" Foreground="{StaticResource FasterBrush}"
                     MaxWidth="420" HorizontalAlignment="Left" MinWidth="240" VerticalAlignment="Center" />
      </Grid>

      <!-- The next run: large, always moving, with the one sentence worth reading -->
      <Border Classes="panel" Padding="20" BorderBrush="{StaticResource InfoBrush}" DataContext="{Binding NextGuide}" x:DataType="vm:GuideRowViewModel"
              IsVisible="{Binding $parent[StackPanel].((vm:RacePlansViewModel)DataContext).NextGuide, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Grid ColumnDefinitions="400,*" ColumnSpacing="28">
          <controls:GuideIllustration Kind="{Binding Kind}" Compound="{Binding Compound}" IsAnimating="True" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="label strong" Text="NEXT RUN" Foreground="{StaticResource InfoBrush}" VerticalAlignment="Center" />
              <Border Classes="pill" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Session}" FontFamily="{StaticResource DisplayFont}" FontSize="11" FontWeight="Bold" LetterSpacing="1.1"
                           Foreground="{StaticResource TextMidBrush}" />
              </Border>
            </StackPanel>
            <TextBlock Classes="h1" FontSize="26" Text="{Binding Title}" TextWrapping="Wrap" />
            <TextBlock Classes="body" Foreground="{StaticResource TextHiBrush}" Text="{Binding Do}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MaxWidth="420" HorizontalAlignment="Left">
              <ProgressBar Classes="bar" Height="10" MinHeight="10" CornerRadius="5" Minimum="0" Maximum="1" Value="{Binding Progress}"
                           Foreground="{Binding ProgressBrush}" MinWidth="260" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="mono" FontSize="13" Foreground="{StaticResource TextMidBrush}" Text="{Binding Count}"
                         IsVisible="{Binding HasCount}" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Everything measured: one line instead of the large card -->
      <TextBlock Classes="body" Text="{Binding GuideNext}"
                 IsVisible="{Binding NextGuide, Converter={x:Static ObjectConverters.IsNull}}" />

      <StackPanel Spacing="8" IsVisible="{Binding HasGuide}">
        <TextBlock Classes="label strong" Text="IN PRACTICE" />
        <ItemsControl ItemsSource="{Binding PracticeGuide}" ItemTemplate="{StaticResource GuideCard}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <TextBlock Classes="label strong" Text="IN THE RACE" />
        <ItemsControl ItemsSource="{Binding RaceGuide}" ItemTemplate="{StaticResource GuideCard}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
    </Panel>
  </DockPanel>
</UserControl>
