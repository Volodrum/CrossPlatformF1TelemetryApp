<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:F1Telemetry.App.ViewModels"
             xmlns:controls="using:F1Telemetry.App.Controls"
             x:Class="F1Telemetry.App.Views.StrategyView"
             x:DataType="vm:SessionViewModel">
  <!-- Design: Strategy.dc.html -->
  <ScrollViewer Margin="0,16,0,0">
    <StackPanel Spacing="16">
      <controls:PageHeader Eyebrow="RACE STRATEGY" Title="{Binding Header}" Margin="0"
                           Help="Stints come from the game's tyre history. Pit, safety-car and out-laps are excluded from every average. Pick a stint to see its tyre life, degradation and fuel; the fuel calculator uses the selected stint's rate." />

      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
        <ListBox Classes="cards horizontal" ItemsSource="{Binding Stints}" SelectedItem="{Binding SelectedStint}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:StintViewModel">
              <StackPanel Orientation="Horizontal" Spacing="12" MinWidth="220">
                <controls:CompoundBadge Compound="{Binding Compound}" Width="40" Height="40" />
                <StackPanel Spacing="2" VerticalAlignment="Center">
                  <TextBlock Classes="h2" Text="{Binding Header}" />
                  <TextBlock Classes="mono" Text="{Binding Laps}" FontSize="13" Foreground="{StaticResource TextMidBrush}" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <ContentControl Content="{Binding SelectedStint}">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="vm:StintViewModel">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
              <!-- Tyre life -->
              <Border Classes="panel" Padding="18">
                <StackPanel Spacing="14">
                  <TextBlock Classes="label strong" Text="TYRE LIFE" FontSize="14" />
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Classes="data-xl" Text="{Binding Lifespan}" />
                    <TextBlock Classes="unit" Text="LAPS · FRESH SET" FontSize="17" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                  </StackPanel>
                  <TextBlock Classes="body" Text="{Binding LifespanNote}" />
                  <ItemsControl ItemsSource="{Binding Wheels}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:WheelRate">
                        <Border Background="{Binding Background}" BorderBrush="{Binding Border}" BorderThickness="2" CornerRadius="8" Padding="10,8" Margin="0,0,8,8">
                          <StackPanel Spacing="2">
                            <TextBlock Classes="label" Text="{Binding Label}" Foreground="{Binding Foreground}" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                              <TextBlock Classes="data-m" FontSize="22" Text="{Binding Rate}" Foreground="{Binding Foreground}" />
                              <TextBlock Classes="unit" FontSize="14" Text="/LAP" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border BorderBrush="{StaticResource SlowerBrush}" BorderThickness="2" CornerRadius="8" Padding="12,10" IsVisible="{Binding HasLimiting}">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Classes="label" Text="{Binding LimitingName}" FontSize="14" Foreground="{StaticResource SlowerBrush}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="data-m" FontSize="22" Text="{Binding LimitingLaps}" Foreground="{StaticResource SlowerBrush}" />
                    </Grid>
                  </Border>
                </StackPanel>
              </Border>

              <!-- Pace degradation -->
              <Border Grid.Column="1" Classes="panel" Padding="18">
                <StackPanel Spacing="14">
                  <TextBlock Classes="label strong" Text="TYRE DEGRADATION" FontSize="14" />
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Classes="data-xl" Text="{Binding Pace}" Foreground="{Binding PaceBrush}" />
                    <TextBlock Classes="unit" Text="S / LAP" FontSize="17" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                  </StackPanel>
                  <TextBlock Classes="body" Text="{Binding PaceNote}" TextWrapping="Wrap" />
                  <TextBlock Classes="muted" Text="{Binding RawPaceNote}" FontSize="13" TextWrapping="Wrap" IsVisible="{Binding HasPace}" />
                  <ItemsControl ItemsSource="{Binding Bars}" Height="130">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:LapBar">
                        <StackPanel Spacing="6" VerticalAlignment="Bottom">
                          <Border Width="30" Height="{Binding Height}" CornerRadius="3" Background="{Binding Fill}" />
                          <TextBlock Classes="mono" Text="{Binding Label}" FontSize="12" Foreground="{StaticResource TextMidBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <UniformGrid Columns="2">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="label" Text="BEST" />
                      <TextBlock Classes="data-m" FontSize="22" Text="{Binding Best}" Foreground="{StaticResource SessionBestBrush}" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                      <TextBlock Classes="label" Text="AVERAGE" />
                      <TextBlock Classes="data-m" FontSize="22" Text="{Binding Average}" />
                    </StackPanel>
                  </UniformGrid>
                </StackPanel>
              </Border>

              <!-- Fuel -->
              <Border Grid.Column="2" Classes="panel" Padding="18">
                <StackPanel Spacing="14">
                  <TextBlock Classes="label strong" Text="FUEL" FontSize="14" />
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Classes="data-xl" Text="{Binding Fuel}" />
                    <TextBlock Classes="unit" Text="KG / LAP" FontSize="17" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                  </StackPanel>
                  <TextBlock Classes="body" Text="{Binding FuelNote}" />
                </StackPanel>
              </Border>
            </Grid>
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>

      <!-- Pit stops: in-lap + out-lap against what each would have been as a clean lap -->
      <Border Classes="panel" Padding="18" IsVisible="{Binding HasPitStops}">
        <StackPanel Spacing="12">
          <TextBlock Classes="label strong" Text="PIT STOPS · TIME LOST ON THE IN-LAP AND OUT-LAP" />
          <ItemsControl ItemsSource="{Binding PitStops}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PitStopRowViewModel">
                <Grid ColumnDefinitions="90,Auto,Auto,Auto,150,*" ColumnSpacing="12" Margin="0,4">
                  <TextBlock Classes="mono" Text="{Binding Laps}" FontSize="14" VerticalAlignment="Center" />
                  <controls:CompoundBadge Grid.Column="1" Compound="{Binding FromCompound}" Width="28" Height="28" />
                  <TextBlock Grid.Column="2" Classes="muted" Text="→" VerticalAlignment="Center" />
                  <controls:CompoundBadge Grid.Column="3" Compound="{Binding ToCompound}" Width="28" Height="28" />
                  <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Classes="data-m" FontSize="22" Text="{Binding Loss}" Foreground="{StaticResource SlowerBrush}" />
                    <TextBlock Classes="unit" Text="S LOST" FontSize="14" VerticalAlignment="Bottom" Margin="0,0,0,3" />
                  </StackPanel>
                  <TextBlock Grid.Column="5" Classes="body" Text="{Binding Detail}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Position history (was its own tab) -->
      <Border Classes="panel" Padding="0" Height="260" IsVisible="{Binding PositionChart, Converter={x:Static ObjectConverters.IsNotNull}}">
        <controls:TelemetryPlot Model="{Binding PositionChart}" />
      </Border>

      <!-- Fuel load calculator (session-level: uses the selected stint's rate) -->
      <Border Classes="panel" HorizontalAlignment="Left" MinWidth="460" Padding="18">
        <StackPanel Spacing="12">
          <TextBlock Classes="label strong" Text="FUEL LOAD CALCULATOR · SELECTED STINT RATE" />
          <StackPanel Orientation="Horizontal" Spacing="16">
            <TextBlock Classes="h2" Text="Target laps" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding TargetLaps}" Minimum="1" Maximum="100" Increment="1" FormatString="0" Width="140" />
            <TextBlock Classes="data-l" Text="{Binding FuelForTarget}" Foreground="#FFD12E" VerticalAlignment="Center" />
            <TextBlock Classes="unit" Text="KG TO ADD" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Strategy optimiser: the track's compound library from every recording, and the race plans it gives -->
      <Border Classes="panel" Padding="18" DataContext="{Binding Plans}" x:DataType="vm:RacePlansViewModel">
        <StackPanel Spacing="16">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="label strong" Text="{Binding Context}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <controls:HelpTip Width="18" Height="18"
                                  Text="Every recording at this track in this game format feeds the library: each clean lap with the fuel weight taken out, fitted as compound pace + tyre age × degradation + the session's own offset, so practice and race laps compare. Tyre life is the laps until the most worn tyre reaches the wear limit (Settings). Plans use two different dry compounds and keep every set within its life; the stint lengths are the fastest split. A stop's window is the in-laps that cost at most 1 s more, the other stops staying put. Undercut: what pitting a lap before a car on the same plan gains on its lap on old tyres (overcut: what staying out gains). The out-lap's cold tyres are part of the pit-stop loss." />
              </StackPanel>
              <TextBlock Classes="muted" FontSize="13" Text="{Binding Basis}" TextWrapping="Wrap" IsVisible="{Binding HasLibrary}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Top">
              <TextBlock Classes="label strong" Text="RACE LAPS" VerticalAlignment="Center" />
              <NumericUpDown Value="{Binding RaceLaps}" Minimum="6" Maximum="100" Increment="1" FormatString="0" Width="140" />
            </StackPanel>
          </Grid>

          <!-- Compound library -->
          <StackPanel Spacing="6" IsVisible="{Binding HasLibrary}">
            <Grid ColumnDefinitions="44,*,120,130,110,90" ColumnSpacing="12">
              <TextBlock Grid.Column="1" Classes="label" Text="COMPOUND" />
              <TextBlock Grid.Column="2" Classes="label" Text="PACE · S" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="3" Classes="label" Text="DEG · S/LAP" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="4" Classes="label" Text="WEAR · %/LAP" HorizontalAlignment="Right" />
              <TextBlock Grid.Column="5" Classes="label" Text="LIFE · LAPS" HorizontalAlignment="Right" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Compounds}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CompoundRowViewModel">
                  <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,8">
                    <Grid ColumnDefinitions="44,*,120,130,110,90" ColumnSpacing="12">
                      <controls:CompoundBadge Compound="{Binding Compound}" Width="32" Height="32" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="h2" FontSize="15" Text="{Binding Name}" />
                        <TextBlock Classes="muted" FontSize="12" Text="{Binding Data}" />
                        <TextBlock Classes="muted" FontSize="12" Text="{Binding Note}" Foreground="{StaticResource SlowerBrush}" TextWrapping="Wrap" IsVisible="{Binding HasNote}" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Classes="data-m" FontSize="20" Text="{Binding Pace}" Foreground="{Binding PaceBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3" Classes="data-m" FontSize="20" Text="{Binding Degradation}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Classes="data-m" FontSize="20" Text="{Binding Wear}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="5" Classes="data-m" FontSize="20" Text="{Binding Life}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <TextBlock Classes="body" Text="{Binding Problem}" Foreground="{StaticResource SlowerBrush}" TextWrapping="Wrap"
                     IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <!-- Ranked plans -->
          <StackPanel Spacing="6" IsVisible="{Binding HasPlans}">
            <TextBlock Classes="label strong" Text="RANKED PLANS · STINT LENGTHS IN LAPS" />
            <ItemsControl ItemsSource="{Binding Plans}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PlanRowViewModel">
                  <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,10">
                    <Grid ColumnDefinitions="44,80,440,130,90,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="6">
                      <TextBlock Classes="data-m" FontSize="20" Text="{Binding RankText}" Foreground="{Binding RankBrush}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Classes="label strong" Text="{Binding StopsText}" VerticalAlignment="Center" />
                      <ItemsControl Grid.Column="2" ItemsSource="{Binding Segments}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:PlanSegmentViewModel">
                            <Border Width="{Binding Width}" Height="32" CornerRadius="4" BorderThickness="2" BorderBrush="{Binding Brush}"
                                    Background="{StaticResource RaisedBrush}" ToolTip.Tip="{Binding Compound}">
                              <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,0" VerticalAlignment="Center" ClipToBounds="True">
                                <controls:CompoundBadge Compound="{Binding Compound}" Width="20" Height="20" />
                                <TextBlock Classes="mono" FontSize="13" Text="{Binding Laps}" VerticalAlignment="Center" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <TextBlock Grid.Column="3" Classes="data-m" FontSize="20" Text="{Binding Time}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="4" Classes="mono" FontSize="15" Text="{Binding Gap}" Foreground="{Binding GapBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                      <ItemsControl Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="4" ItemsSource="{Binding Stops}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel ItemSpacing="20" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:PlanStopViewModel">
                            <TextBlock FontSize="13">
                              <Run Text="{Binding Pit}" FontWeight="Bold" Foreground="{StaticResource TextHiBrush}" />
                              <Run Text=" · " Foreground="{StaticResource TextLoBrush}" />
                              <Run Text="{Binding Window}" Foreground="{StaticResource TextMidBrush}" />
                              <Run Text=" · " Foreground="{StaticResource TextLoBrush}" />
                              <Run Text="{Binding Undercut}" Foreground="{Binding UndercutBrush}" />
                            </TextBlock>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <Border Classes="panel" Padding="0" Height="420" Background="{StaticResource RaisedBrush}"
                  IsVisible="{Binding PlanChart, Converter={x:Static ObjectConverters.IsNotNull}}">
            <controls:TelemetryPlot Model="{Binding PlanChart}" />
          </Border>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
