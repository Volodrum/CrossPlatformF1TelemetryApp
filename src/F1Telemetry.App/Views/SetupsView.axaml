<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:F1Telemetry.App.ViewModels"
             xmlns:controls="using:F1Telemetry.App.Controls"
             x:Class="F1Telemetry.App.Views.SetupsView"
             x:DataType="vm:SetupsViewModel">
  <DockPanel Margin="0,16,0,0">
    <controls:PageHeader DockPanel.Dock="Top" Eyebrow="SETUP LIBRARY" Title="{Binding Header}"
                         Help="Every setup you drive in a recorded session lands here with its track, weather and lap times. Star favourites, tick setups to export them as a .f1setups file, or import one. Select a setup to rename it, add notes and compare it with another." />

    <TextBlock DockPanel.Dock="Bottom" Classes="body" Text="{Binding Status}" Margin="0,10,0,0" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

    <Grid ColumnDefinitions="*,460" ColumnSpacing="12">
      <!-- Library -->
      <Border Classes="panel" Padding="8">
        <DockPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="8,4,8,10" ItemSpacing="10" LineSpacing="8">
            <ComboBox ItemsSource="{Binding Tracks}" SelectedItem="{Binding TrackFilter}" MinWidth="170" />
            <ComboBox ItemsSource="{x:Static vm:SetupsViewModel.WeatherFilters}" SelectedItem="{Binding WeatherFilter}" MinWidth="150" />
            <ToggleSwitch IsChecked="{Binding FavouritesOnly}" OnContent="FAVOURITES" OffContent="FAVOURITES" />
          </WrapPanel>

          <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="8,10,8,4">
            <Button Theme="{StaticResource SecondaryButton}" Content="TICK SHOWN" Command="{Binding TickShownCommand}" />
            <TextBlock Grid.Column="1" Classes="label strong" Text="{Binding CheckedText}" VerticalAlignment="Center" Margin="4,0" TextTrimming="CharacterEllipsis" />
            <Button Grid.Column="2" Theme="{StaticResource SecondaryButton}" Content="IMPORT…" Command="{Binding ImportCommand}" />
            <Button Grid.Column="3" Theme="{StaticResource PrimaryButton}" Content="EXPORT SELECTED…" Command="{Binding ExportCommand}" />
          </Grid>

          <Grid DockPanel.Dock="Top" ColumnDefinitions="32,36,*,76,92,100" ColumnSpacing="8" Margin="12,0,12,8">
            <TextBlock Grid.Column="2" Classes="label" Text="SETUP" />
            <TextBlock Grid.Column="3" Classes="label" Text="WINGS" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="4" Classes="label" Text="CONDITIONS" />
            <TextBlock Grid.Column="5" Classes="label" Text="BEST LAP" HorizontalAlignment="Center" />
          </Grid>

          <Panel>
            <TextBlock Classes="body" Margin="12" TextWrapping="Wrap" IsVisible="{Binding !HasSetups}"
                       Text="No setups yet. Every setup you drive in a recorded session lands here with its track, weather and lap times. You can also import a .f1setups file." />
            <ListBox Classes="rows" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedSetup}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SetupRowViewModel">
                  <Grid ColumnDefinitions="32,36,*,76,92,100" ColumnSpacing="8">
                    <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" ToolTip.Tip="Include in the export" />
                    <Button Grid.Column="1" Command="{Binding ToggleFavouriteCommand}" Width="36" Height="36" Padding="0" Background="Transparent" BorderThickness="0"
                            ToolTip.Tip="{Binding FavouriteTip}" AutomationProperties.Name="{Binding FavouriteTip}" VerticalAlignment="Center">
                      <PathIcon Width="18" Height="18" Foreground="{Binding StarBrush}"
                                Data="M12,2 L15.09,8.26 L22,9.27 L17,14.14 L18.18,21.02 L12,17.77 L5.82,21.02 L7,14.14 L2,9.27 L8.91,8.26 Z" />
                    </Button>
                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Classes="h2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="mono" FontSize="13" Text="{Binding Subtitle}" Foreground="{StaticResource TextMidBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Classes="data-s" Text="{Binding Wings}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="4" Spacing="4" VerticalAlignment="Center">
                      <ItemsControl ItemsSource="{Binding WeatherChips}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel ItemSpacing="6" LineSpacing="4" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                      </ItemsControl>
                      <TextBlock Classes="mono" FontSize="13" Text="{Binding TrackTemperatures}" Foreground="{StaticResource TextMidBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="5" Spacing="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                      <ContentControl Content="{Binding BestLap}" HorizontalAlignment="Center" />
                      <TextBlock Classes="mono" FontSize="13" Text="{Binding LastDriven}" Foreground="{StaticResource TextLoBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Panel>
        </DockPanel>
      </Border>

      <!-- Selected setup -->
      <Border Grid.Column="1" Classes="panel" Padding="0" IsVisible="{Binding HasSelection}">
        <ScrollViewer>
          <StackPanel Spacing="14" Margin="18">
            <StackPanel Spacing="6">
              <TextBlock Classes="label" Text="NAME · EMPTY FOR THE AUTOMATIC NAME" />
              <TextBox Text="{Binding EditName, UpdateSourceTrigger=LostFocus}" PlaceholderText="{Binding SelectedSetup.Name, FallbackValue=''}" FontSize="16" />
              <TextBlock Classes="mono" FontSize="13" Text="{Binding SelectedSetup.Subtitle, FallbackValue=''}" Foreground="{StaticResource TextMidBrush}" />
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Classes="label" Text="NOTES" />
              <TextBox Text="{Binding EditNotes, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                       PlaceholderText="How the car felt, what to try next" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Classes="label strong" Text="COMPARE WITH" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding CompareOptions}" SelectedItem="{Binding CompareWith}" MinWidth="240" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Groups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SettingGroupViewModel">
                  <StackPanel Spacing="4" Margin="0,0,0,12">
                    <TextBlock Classes="label strong" Text="{Binding Name}" Margin="0,0,0,2" />
                    <ItemsControl ItemsSource="{Binding Settings}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SettingRowViewModel">
                          <Grid ColumnDefinitions="*,84,76,76" ColumnSpacing="8" Margin="0,2">
                            <TextBlock Classes="body" Text="{Binding Label}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Classes="data-s" FontSize="17" Text="{Binding Value}" Foreground="{Binding ValueBrush}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="2" Classes="mono" Text="{Binding Other}" Foreground="{StaticResource TextLoBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Classes="mono" FontWeight="Bold" Text="{Binding Change}" Foreground="{StaticResource InfoBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Spacing="8">
              <TextBlock Classes="label strong" Text="RUNS" />
              <TextBlock Classes="body" Text="Not driven in a recording yet." IsVisible="{Binding !HasRuns}" />
              <ItemsControl ItemsSource="{Binding Runs}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SetupRunViewModel">
                    <Border Background="{StaticResource CardBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,6">
                      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="4">
                        <TextBlock Classes="h2" FontSize="15" Text="{Binding Session}" />
                        <TextBlock Grid.Row="1" Classes="mono" FontSize="13" Foreground="{StaticResource TextMidBrush}" TextWrapping="Wrap">
                          <Run Text="{Binding When}" /><Run Text=" · " /><Run Text="{Binding Laps}" /><Run Text=" · top " /><Run Text="{Binding TopSpeed}" />
                        </TextBlock>
                        <ContentControl Grid.Column="1" Grid.RowSpan="2" Content="{Binding Best}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Classes="body" FontSize="13" Text="{Binding Conditions}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <Button Theme="{StaticResource SecondaryButton}" Content="{Binding RemoveText}" Command="{Binding RemoveCommand}" HorizontalAlignment="Left"
                    ToolTip.Tip="Remove this setup from the library" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
