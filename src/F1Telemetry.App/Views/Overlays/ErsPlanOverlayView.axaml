<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:F1Telemetry.App.ViewModels"
             x:Class="F1Telemetry.App.Views.Overlays.ErsPlanOverlayView"
             x:DataType="vm:ErsPlanOverlayViewModel"
             Width="300">
  <Border Classes="hud">
    <Panel>
      <TextBlock Classes="body" FontSize="14" Text="{Binding Status}" TextWrapping="Wrap" IsVisible="{Binding !HasPlan}" />

      <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="12" IsVisible="{Binding HasPlan}">
        <!-- Now: the mode the plan wants here, ringed amber when the car runs another -->
        <Border Width="80" Height="80" CornerRadius="8" Background="{Binding NowFill}" BorderBrush="{Binding NowBorder}" BorderThickness="3">
          <TextBlock Text="{Binding NowLetter}" Foreground="{Binding NowForeground}" FontFamily="{StaticResource DataFont}" FontSize="60"
                     FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <Path Grid.Column="1" Data="M0,0 L10,9 L0,18" Stroke="{StaticResource TextMidBrush}" StrokeThickness="3" VerticalAlignment="Center" />

        <!-- Next: the mode after the switch -->
        <Border Grid.Column="2" Width="46" Height="46" CornerRadius="6" Background="{Binding NextFill}" VerticalAlignment="Center">
          <TextBlock Text="{Binding NextLetter}" Foreground="{Binding NextForeground}" FontFamily="{StaticResource DataFont}" FontSize="30"
                     FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <!-- Which plan runs (the hotkey steps through them), then the time until the switch -->
        <Panel Grid.Column="3">
          <TextBlock Classes="label strong" FontSize="11" Text="{Binding PlanTag}" Foreground="{Binding PlanTagBrush}"
                     HorizontalAlignment="Right" VerticalAlignment="Top" />
          <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <TextBlock Classes="data-m" FontSize="34" Text="{Binding Countdown}" />
            <TextBlock Classes="unit" FontSize="15" Text="{Binding CountdownUnit}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
          </StackPanel>
        </Panel>
      </Grid>
    </Panel>
  </Border>
</UserControl>
