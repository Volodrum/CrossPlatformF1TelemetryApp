<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:F1Telemetry.App.ViewModels"
             xmlns:controls="using:F1Telemetry.App.Controls"
             x:Class="F1Telemetry.App.Views.Overlays.SectorBoxOverlayView"
             x:DataType="vm:SectorBoxOverlayViewModel"
             Width="400">
  <!-- TV qualifying graphic: header, three colour-only sector bars, then the lap time. For 4 s after a split the sector
       time and its gap (coloured text) replace the lap time; at the line the lap time stays with the lap gap. -->
  <Border Classes="hud" Padding="0">
    <StackPanel>
      <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10" Margin="10,10,12,8">
        <Border Background="{Binding PositionBackground}" CornerRadius="6" MinWidth="46" Padding="6,1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Position}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="Bold"
                     Foreground="{StaticResource OnColorBrush}" HorizontalAlignment="Center" />
        </Border>
        <Border Grid.Column="1" Width="5" Height="26" CornerRadius="3" Background="{Binding TeamBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="YOU" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="Bold" LetterSpacing="1.5"
                   VerticalAlignment="Center" />
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Classes="label" Text="{Binding ReferenceLabel}" FontSize="12" VerticalAlignment="Center" />
          <TextBlock Classes="data-s" Text="{Binding ReferenceTime}" FontSize="16" Foreground="{StaticResource TextMidBrush}" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>

      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4" Margin="10,0">
        <controls:SectorBar Mark="{Binding Sector1}" Progress="{Binding Progress1}" />
        <controls:SectorBar Grid.Column="1" Mark="{Binding Sector2}" Progress="{Binding Progress2}" />
        <controls:SectorBar Grid.Column="2" Mark="{Binding Sector3}" Progress="{Binding Progress3}" />
      </Grid>

      <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,8,12,10" MinHeight="48">
        <Border Background="{Binding LapTimeBackground}" CornerRadius="7" Padding="8,0" VerticalAlignment="Center" IsVisible="{Binding ShowLapTime}">
          <Panel>
            <TextBlock Text="{Binding LapTime}" FontFamily="{StaticResource DataFont}" FontSize="34" FontWeight="ExtraBold"
                       Foreground="{Binding LapTimeForeground}" />
            <!-- Deleted lap: struck through in red. -->
            <Border Height="3" Background="{StaticResource DangerBrush}" VerticalAlignment="Center" IsVisible="{Binding IsInvalid}" />
          </Panel>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{Binding ShowSplit}">
          <TextBlock Classes="label strong" Text="{Binding SplitLabel}" FontSize="18" VerticalAlignment="Center" />
          <TextBlock Text="{Binding SplitTime}" FontFamily="{StaticResource DataFont}" FontSize="34" FontWeight="ExtraBold" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Delta}" Foreground="{Binding DeltaBrush}" FontFamily="{StaticResource DataFont}" FontSize="34"
                   FontWeight="ExtraBold" VerticalAlignment="Center" IsVisible="{Binding HasDelta}" />
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
