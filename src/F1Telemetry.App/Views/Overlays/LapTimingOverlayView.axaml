<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:F1Telemetry.App.ViewModels"
             x:Class="F1Telemetry.App.Views.Overlays.LapTimingOverlayView"
             x:DataType="vm:LapTimingOverlayViewModel"
             Width="560">
  <!-- Fixed columns sized for 18 px mono digits: LAP 44 · S1–S3 84 · TIME 108 · Δ 76 (+ 8 px gaps). -->
  <Border Classes="hud">
    <StackPanel Spacing="8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="label strong" Text="LAP TIMING" FontSize="14" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="label" Text="BEST" Foreground="{StaticResource SessionBestBrush}" VerticalAlignment="Center" />
          <TextBlock Classes="data-s" Text="{Binding BestLap}" FontSize="20" FontWeight="ExtraBold" Foreground="{StaticResource SessionBestBrush}" />
        </StackPanel>
      </Grid>
      <Grid ColumnDefinitions="44,84,84,84,108,76" ColumnSpacing="8">
        <TextBlock Classes="label" Text="LAP" FontSize="12" Margin="6,0,0,0" />
        <TextBlock Grid.Column="1" Classes="label" Text="S1" FontSize="12" HorizontalAlignment="Center" />
        <TextBlock Grid.Column="2" Classes="label" Text="S2" FontSize="12" HorizontalAlignment="Center" />
        <TextBlock Grid.Column="3" Classes="label" Text="S3" FontSize="12" HorizontalAlignment="Center" />
        <TextBlock Grid.Column="4" Classes="label" Text="TIME" FontSize="12" HorizontalAlignment="Right" Margin="0,0,8,0" />
        <TextBlock Grid.Column="5" Classes="label" Text="Δ" FontSize="12" HorizontalAlignment="Right" Margin="0,0,6,0" />
      </Grid>
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:LapTimingRow">
            <Border Background="{Binding RowBackground}" CornerRadius="6" Padding="0,5" Margin="0,0,0,4">
              <Grid ColumnDefinitions="44,84,84,84,108,76" ColumnSpacing="8">
                <TextBlock Classes="h2" Text="{Binding Lap}" Foreground="{Binding LapBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                <ContentControl Grid.Column="1" Content="{Binding S1}" />
                <ContentControl Grid.Column="2" Content="{Binding S2}" />
                <ContentControl Grid.Column="3" Content="{Binding S3}" />
                <ContentControl Grid.Column="4" Content="{Binding Time}" />
                <TextBlock Grid.Column="5" Classes="data-s" Text="{Binding Delta}" Foreground="{Binding DeltaBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>
