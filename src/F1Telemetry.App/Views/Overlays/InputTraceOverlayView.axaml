<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:F1Telemetry.App.ViewModels"
             xmlns:controls="using:F1Telemetry.App.Controls"
             x:Class="F1Telemetry.App.Views.Overlays.InputTraceOverlayView"
             x:DataType="vm:InputTraceOverlayViewModel"
             Width="552">
  <Border Classes="hud">
    <DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
        <TextBlock Classes="label strong" Text="{Binding Header}" FontSize="14" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="16" Height="5" CornerRadius="2" Background="{StaticResource FasterBrush}" VerticalAlignment="Center" /><TextBlock Classes="label" Text="THROTTLE" Foreground="{StaticResource FasterBrush}" /></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="16" Height="5" CornerRadius="2" Background="{StaticResource DangerBrush}" VerticalAlignment="Center" /><TextBlock Classes="label" Text="BRAKE" Foreground="{StaticResource DangerBrush}" /></StackPanel>
        </StackPanel>
      </Grid>
      <controls:InputTraceControl Height="150" History="{Binding History}" WindowSeconds="{Binding WindowSeconds}" Preview="{Binding Preview}" />
    </DockPanel>
  </Border>
</UserControl>
